# Gemini is the primary engine. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL_NAME=gemini-flash-latest

# Local fallback (used automatically if Gemini errors out, hits a quota
# limit, or GOOGLE_API_KEY is left blank). Install Ollama from
# https://ollama.com, then run: ollama pull llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_PREFERENCE=llama3.2:1b,llama3.2,phi3.5,gemma2:2b,qwen2.5:3b,mistral
